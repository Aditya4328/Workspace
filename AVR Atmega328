10) Automated cooling system using an LM35 sensor and a DC motor
#define F_CPU 16000000UL

#include <avr/io.h>
#include <util/delay.h>

// Pin definitions
#define MOTOR_PWM PD6
#define BUTTON    PD2

// Function declarations
void adc_init(void);
unsigned int read_temperature(void);
unsigned char calculate_speed(unsigned int temp);
void motor_control(unsigned char speed);
void pwm_init(void);

int main(void)
{
    unsigned int temperature;
    unsigned char speed;
    unsigned char system_on = 0;

    // Initialize ADC and PWM
    adc_init();
    pwm_init();

    // Configure button as input
    DDRD &= ~(1 << BUTTON);

    // Enable internal pull-up
    PORTD |= (1 << BUTTON);

    // Initially motor OFF
    motor_control(0);

    while (1)
    {
        // Check push-button
        if (!(PIND & (1 << BUTTON)))
        {
            _delay_ms(50);

            if (!(PIND & (1 << BUTTON)))
            {
                // Toggle system ON/OFF
                system_on = !system_on;

                // Wait until button is released
                while (!(PIND & (1 << BUTTON)));

                _delay_ms(50);
            }
        }

        if (system_on)
        {
            // Read temperature from LM35
            temperature = read_temperature();

            // Calculate motor speed
            speed = calculate_speed(temperature);

            // Control motor
            motor_control(speed);
        }
        else
        {
            // System OFF
            motor_control(0);
        }

        _delay_ms(200);
    }

    return 0;
}

// Initialize ADC
void adc_init(void)
{
    // AVCC reference, ADC0 input
    ADMUX = (1 << REFS0);

    // Enable ADC, prescaler = 128
    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);
}

// Read temperature from LM35
unsigned int read_temperature(void)
{
    unsigned int adc_value;
    unsigned int temperature;

    // Start ADC conversion
    ADCSRA |= (1 << ADSC);

    // Wait for conversion
    while (ADCSRA & (1 << ADSC));

    adc_value = ADC;

    // Convert ADC value to Celsius
    temperature = (adc_value * 500UL) / 1024;

    return temperature;
}

// Calculate motor speed based on temperature
unsigned char calculate_speed(unsigned int temp)
{
    if (temp < 25)
    {
        return 77;    // Approximately 30% speed
    }
    else if (temp < 35)
    {
        return 153;   // Approximately 60% speed
    }
    else
    {
        return 255;   // 100% speed
    }
}

// Initialize Timer0 PWM
void pwm_init(void)
{
    // Configure PD6 (OC0A) as output
    DDRD |= (1 << MOTOR_PWM);

    // Fast PWM, non-inverting mode
    TCCR0A = (1 << WGM00) |
             (1 << WGM01) |
             (1 << COM0A1);

    // Prescaler = 64
    TCCR0B = (1 << CS01) | (1 << CS00);

    OCR0A = 0;
}

// Control motor speed
void motor_control(unsigned char speed)
{
    OCR0A = speed;
}

