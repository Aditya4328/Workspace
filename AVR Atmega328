#define F_CPU 16000000UL

#include <avr/io.h>
#include <stdint.h>

// Function declarations
void adc_init(void);
uint16_t read_potentiometer(void);
void timer1_init(void);
void set_servo_position(uint16_t adc_value);

int main(void)
{
    uint16_t adc_value;

    // Initialize ADC
    adc_init();

    // Initialize Timer1 for servo PWM
    timer1_init();

    while (1)
    {
        // Read potentiometer value
        adc_value = read_potentiometer();

        // Update servo position
        set_servo_position(adc_value);
    }

    return 0;
}

// Initialize ADC
void adc_init(void)
{
    // AVCC reference, ADC0 input
    ADMUX = (1 << REFS0);

    // Enable ADC, prescaler = 128
    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);
}

// Read 10-bit analog value
uint16_t read_potentiometer(void)
{
    // Start ADC conversion
    ADCSRA |= (1 << ADSC);

    // Wait for conversion to complete
    while (ADCSRA & (1 << ADSC));

    return ADC;
}

// Initialize Timer1
void timer1_init(void)
{
    // Configure PB1 (OC1A) as output
    DDRB |= (1 << PB1);

    // Phase Correct PWM, TOP = ICR1
    // Mode 10: WGM13 = 1, WGM11 = 1
    TCCR1A = (1 << WGM11) | (1 << COM1A1);

    TCCR1B = (1 << WGM13) | (1 << CS11);

    // Set TOP value for 50 Hz
    ICR1 = 20000;

    // Initial servo pulse width = 1 ms
    OCR1A = 1000;
}

// Set servo position based on ADC value
void set_servo_position(uint16_t adc_value)
{
    // Map ADC value (0-1023)
    // to servo pulse width (1-2 ms)
    OCR1A = 1000 + ((uint32_t)adc_value * 1000) / 1023;
}

12) Show a 9-digit number on an LCD screen that increases with a quick button press and resets to zero with a long press

#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdio.h>
#include <stdint.h>

/* LCD connections */
#define LCD_RS PB0
#define LCD_EN PB2

/* Button connection */
#define BUTTON PD2

volatile uint32_t milliseconds = 0;

uint32_t counter = 0;

/* Timer0 interrupt: 1 ms */
void timer0_init(void)
{
    TCCR0A = (1 << WGM01);              // CTC mode
    TCCR0B = (1 << CS01) | (1 << CS00); // Prescaler 64

    OCR0A = 249;                        // 1 ms at 16 MHz
    TIMSK0 = (1 << OCIE0A);             // Enable compare interrupt

    sei();
}

ISR(TIMER0_COMPA_vect)
{
    milliseconds++;
}

/* LCD enable pulse */
void lcd_enable(void)
{
    PORTB |= (1 << LCD_EN);
    _delay_us(1);
    PORTB &= ~(1 << LCD_EN);
    _delay_us(100);
}

/* Send 4 bits to LCD */
void lcd_nibble(uint8_t data)
{
    PORTD = (PORTD & 0x0F) | (data & 0xF0);
    lcd_enable();
}

/* Send command to LCD */
void lcd_command(uint8_t cmd)
{
    PORTB &= ~(1 << LCD_RS);

    lcd_nibble(cmd);
    lcd_nibble(cmd << 4);

    _delay_ms(2);
}

/* Send character to LCD */
void lcd_data(uint8_t data)
{
    PORTB |= (1 << LCD_RS);

    lcd_nibble(data);
    lcd_nibble(data << 4);

    _delay_ms(2);
}

/* Initialize LCD */
void lcd_init(void)
{
    DDRB |= (1 << LCD_RS) | (1 << LCD_EN);
    DDRD |= 0xF0;

    _delay_ms(20);

    PORTB &= ~(1 << LCD_RS);

    lcd_nibble(0x30);
    _delay_ms(5);

    lcd_nibble(0x30);
    _delay_us(150);

    lcd_nibble(0x30);
    lcd_nibble(0x20);

    lcd_command(0x28); // 4-bit, 2-line LCD
    lcd_command(0x0C); // Display ON, cursor OFF
    lcd_command(0x06); // Auto increment
    lcd_command(0x01); // Clear display
}

/* Display the 9-digit counter */
void update_lcd(uint32_t value)
{
    char buffer[10];

    snprintf(buffer, sizeof(buffer), "%09lu",
             (unsigned long)value);

    lcd_command(0x80);
    lcd_data('C');
    lcd_data('o');
    lcd_data('u');
    lcd_data('n');
    lcd_data('t');
    lcd_data('e');
    lcd_data('r');
    lcd_data(':');

    lcd_command(0xC0);

    for (uint8_t i = 0; i < 9; i++)
    {
        lcd_data(buffer[i]);
    }
}

/* Check how long the button is held */
uint8_t check_button_press(void)
{
    uint32_t press_start;
    uint32_t press_duration;

    if (!(PIND & (1 << BUTTON)))
    {
        _delay_ms(30); // Debounce

        if (!(PIND & (1 << BUTTON)))
        {
            press_start = milliseconds;

            while (!(PIND & (1 << BUTTON)))
            {
                // Wait until button is released
            }

            press_duration = milliseconds - press_start;

            _delay_ms(30); // Release debounce

            if (press_duration >= 2000)
            {
                return 2; // Long press
            }
            else
            {
                return 1; // Short press
            }
        }
    }

    return 0;
}

int main(void)
{
    uint8_t button_status;

    /* Configure button as input with pull-up */
    DDRD &= ~(1 << BUTTON);
    PORTD |= (1 << BUTTON);

    lcd_init();
    timer0_init();

    counter = 0;
    update_lcd(counter);

    while (1)
    {
        button_status = check_button_press();

        if (button_status == 1)
        {
            if (counter < 999999999UL)
            {
                counter++;
            }

            update_lcd(counter);
        }
        else if (button_status == 2)
        {
            counter = 0;
            update_lcd(counter);
        }
    }
}

13) Manage an LED’s state and intensity through a serial terminal while providing real-time status updates back to the user

#define F_CPU 16000000UL
#define BAUD 9600
#define UBRR_VALUE ((F_CPU / (16UL * BAUD)) - 1)

#include <avr/io.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

/* Function declarations */
void uart_init(void);
void uart_transmit(char data);
void uart_print(char *str);
char uart_receive(void);

void pwm_init(void);
void set_brightness(uint8_t value);

void process_command(char *command);

/* Initialize UART */
void uart_init(void)
{
    UBRR0H = (uint8_t)(UBRR_VALUE >> 8);
    UBRR0L = (uint8_t)UBRR_VALUE;

    UCSR0B = (1 << RXEN0) | (1 << TXEN0);

    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

/* Transmit one character */
void uart_transmit(char data)
{
    while (!(UCSR0A & (1 << UDRE0)));

    UDR0 = data;
}

/* Transmit a string */
void uart_print(char *str)
{
    while (*str)
    {
        uart_transmit(*str++);
    }
}

/* Receive one character */
char uart_receive(void)
{
    while (!(UCSR0A & (1 << RXC0)));

    return UDR0;
}

/* Initialize Timer0 Fast PWM */
void pwm_init(void)
{
    DDRD |= (1 << PD6);  // OC0A output

    TCCR0A = (1 << COM0A1) |
             (1 << WGM01) |
             (1 << WGM00);

    TCCR0B = (1 << CS01) | (1 << CS00);
    // Fast PWM, prescaler 64

    OCR0A = 0;  // LED initially OFF
}

/* Set LED brightness from 0 to 100 */
void set_brightness(uint8_t value)
{
    OCR0A = ((uint16_t)value * 255) / 100;
}

/* Process received commands */
void process_command(char *command)
{
    uint8_t value;
    char *endptr;

    if (strcmp(command, "ON") == 0)
    {
        set_brightness(100);
        uart_print("LED is now ON\r\n");
    }

    else if (strcmp(command, "OFF") == 0)
    {
        set_brightness(0);
        uart_print("LED is now OFF\r\n");
    }

    else
    {
        value = (uint8_t)strtol(command, &endptr, 10);

        if (*command != '\0' &&
            *endptr == '\0' &&
            value <= 100)
        {
            set_brightness(value);

            uart_print("Brightness set to ");
            
            char buffer[5];
            itoa(value, buffer, 10);

            uart_print(buffer);
            uart_print("%\r\n");
        }
        else
        {
            uart_print("Invalid command. Use ON, OFF or 0-100\r\n");
        }
    }
}

/* Main function */
int main(void)
{
    char command[10];
    uint8_t index = 0;
    char received;

    uart_init();
    pwm_init();

    uart_print("UART LED Control Ready\r\n");
    uart_print("Enter ON, OFF or brightness (0-100)\r\n");

    while (1)
    {
        received = uart_receive();

        if (received == '\r' || received == '\n')
        {
            if (index > 0)
            {
                command[index] = '\0';

                process_command(command);

                index = 0;
            }
        }
        else
        {
            if (index < sizeof(command) - 1)
            {
                command[index++] = received;
            }
            else
            {
                index = 0;
                uart_print("Command too long\r\n");
            }
        }
    }
}

14) Regulate the rotational speed of a DC motor by mapping an analog input signal to a PWM output

#define F_CPU 16000000UL

#include <avr/io.h>
#include <stdint.h>

/* Function declarations */
void adc_init(void);
uint16_t read_adc(void);

void pwm_init(void);
void motor_speed(uint8_t speed);

int main(void)
{
    uint16_t adc_value;
    uint8_t pwm_value;

    /* Initialize ADC and PWM */
    adc_init();
    pwm_init();

    while (1)
    {
        /* Read 10-bit ADC value */
        adc_value = read_adc();

        /* Convert 10-bit value to 8-bit PWM value */
        pwm_value = (uint32_t)adc_value * 255 / 1023;

        /* Set motor speed */
        motor_speed(pwm_value);
    }

    return 0;
}

/* Initialize ADC */
void adc_init(void)
{
    ADMUX = (1 << REFS0); 

    /* AVCC reference, ADC0 channel */

    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);

    /* Enable ADC, prescaler = 128 */
}

/* Read analog value from ADC0 */
uint16_t read_adc(void)
{
    ADCSRA |= (1 << ADSC);

    /* Start ADC conversion */

    while (ADCSRA & (1 << ADSC));

    /* Wait until conversion completes */

    return ADC;
}

/* Initialize Timer0 in Fast PWM mode */
void pwm_init(void)
{
    DDRD |= (1 << PD6);

    /* Configure PD6 as PWM output */

    TCCR0A = (1 << COM0A1) |
             (1 << WGM01) |
             (1 << WGM00);

    /* Fast PWM, non-inverting mode */

    TCCR0B = (1 << CS01) |
             (1 << CS00);

    /* Prescaler = 64 */

    OCR0A = 0;

    /* Motor initially stopped */
}

/* Set motor speed using PWM */
void motor_speed(uint8_t speed)
{
    OCR0A = speed;
}

15) Read temperature data and pressure from a BMP280 sensor and display the real-time value on an OLED screen

#define F_CPU 16000000UL

#include <avr/io.h>
#include <util/delay.h>
#include <stdint.h>
#include <stdio.h>

/* I2C addresses: 7-bit */
#define BMP_ADDR  0x76
#define OLED_ADDR 0x3C

/* BMP280 calibration data */
uint16_t dig_T1;
int16_t dig_T2, dig_T3;

uint16_t dig_P1;
int16_t dig_P2, dig_P3, dig_P4;
int16_t dig_P5, dig_P6, dig_P7;
int16_t dig_P8, dig_P9;

int32_t t_fine;

/* Function declarations */
void i2c_init(void);
void i2c_start(uint8_t address);
void i2c_write(uint8_t data);
uint8_t i2c_read_ack(void);
uint8_t i2c_read_nack(void);
void i2c_stop(void);

void bmp_write(uint8_t reg, uint8_t data);
uint8_t bmp_read(uint8_t reg);
void bmp_read_calibration(void);
void bmp_init(void);

int32_t read_temperature(void);
uint32_t read_pressure(void);

void oled_command(uint8_t cmd);
void oled_data(uint8_t data);
void oled_init(void);
void oled_clear(void);
void oled_cursor(uint8_t page, uint8_t column);
void oled_char(char c);
void oled_string(char *str);

void delay_2_seconds(void);

/* ---------------- I2C FUNCTIONS ---------------- */

void i2c_init(void)
{
    TWSR = 0x00;       // Prescaler = 1
    TWBR = 72;         // 100 kHz at 16 MHz
    TWCR = (1 << TWEN);
}

void i2c_start(uint8_t address)
{
    TWCR = (1 << TWINT) |
           (1 << TWSTA) |
           (1 << TWEN);

    while (!(TWCR & (1 << TWINT)));

    TWDR = address;

    TWCR = (1 << TWINT) | (1 << TWEN);

    while (!(TWCR & (1 << TWINT)));
}

void i2c_write(uint8_t data)
{
    TWDR = data;

    TWCR = (1 << TWINT) | (1 << TWEN);

    while (!(TWCR & (1 << TWINT)));
}

uint8_t i2c_read_ack(void)
{
    TWCR = (1 << TWINT) |
           (1 << TWEN) |
           (1 << TWEA);

    while (!(TWCR & (1 << TWINT)));

    return TWDR;
}

uint8_t i2c_read_nack(void)
{
    TWCR = (1 << TWINT) | (1 << TWEN);

    while (!(TWCR & (1 << TWINT)));

    return TWDR;
}

void i2c_stop(void)
{
    TWCR = (1 << TWINT) |
           (1 << TWEN) |
           (1 << TWSTO);
}

/* ---------------- BMP280 FUNCTIONS ---------------- */

void bmp_write(uint8_t reg, uint8_t data)
{
    i2c_start((BMP_ADDR << 1) | 0);

    i2c_write(reg);
    i2c_write(data);

    i2c_stop();
}

uint8_t bmp_read(uint8_t reg)
{
    uint8_t data;

    i2c_start((BMP_ADDR << 1) | 0);
    i2c_write(reg);

    i2c_start((BMP_ADDR << 1) | 1);

    data = i2c_read_nack();

    i2c_stop();

    return data;
}

/* Read BMP280 calibration coefficients */
void bmp_read_calibration(void)
{
    uint8_t c[24];

    i2c_start((BMP_ADDR << 1) | 0);
    i2c_write(0x88);

    i2c_start((BMP_ADDR << 1) | 1);

    for (uint8_t i = 0; i < 23; i++)
        c[i] = i2c_read_ack();

    c[23] = i2c_read_nack();

    i2c_stop();

    dig_T1 = (uint16_t)c[1] << 8 | c[0];
    dig_T2 = (int16_t)((uint16_t)c[3] << 8 | c[2]);
    dig_T3 = (int16_t)((uint16_t)c[5] << 8 | c[4]);

    dig_P1 = (uint16_t)c[7] << 8 | c[6];
    dig_P2 = (int16_t)((uint16_t)c[9] << 8 | c[8]);
    dig_P3 = (int16_t)((uint16_t)c[11] << 8 | c[10]);
    dig_P4 = (int16_t)((uint16_t)c[13] << 8 | c[12]);
    dig_P5 = (int16_t)((uint16_t)c[15] << 8 | c[14]);
    dig_P6 = (int16_t)((uint16_t)c[17] << 8 | c[16]);
    dig_P7 = (int16_t)((uint16_t)c[19] << 8 | c[18]);
    dig_P8 = (int16_t)((uint16_t)c[21] << 8 | c[20]);
    dig_P9 = (int16_t)((uint16_t)c[23] << 8 | c[22]);
}

void bmp_init(void)
{
    bmp_write(0xE0, 0xB6); // Software reset

    _delay_ms(10);

    bmp_read_calibration();

    bmp_write(0xF5, 0xA0); // Standby/filter configuration

    bmp_write(0xF4, 0x27);
    // Temperature x1, pressure x1, normal mode
}

/* Read and compensate temperature */
int32_t read_temperature(void)
{
    int32_t adc_T;
    int32_t var1, var2;
    int32_t temperature;

    uint8_t msb, lsb, xlsb;

    msb  = bmp_read(0xFA);
    lsb  = bmp_read(0xFB);
    xlsb = bmp_read(0xFC);

    adc_T = ((int32_t)msb << 12) |
            ((int32_t)lsb << 4) |
            (xlsb >> 4);

    var1 = ((((adc_T >> 3) -
             ((int32_t)dig_T1 << 1))) *
             dig_T2) >> 11;

    var2 = (((((adc_T >> 4) - dig_T1) *
             ((adc_T >> 4) - dig_T1)) >> 12) *
             dig_T3) >> 14;

    t_fine = var1 + var2;

    temperature = (t_fine * 5 + 128) >> 8;

    return temperature;
}

/* Read and compensate pressure */
uint32_t read_pressure(void)
{
    int32_t adc_P;
    int64_t var1, var2, p;

    uint8_t msb, lsb, xlsb;

    msb  = bmp_read(0xF7);
    lsb  = bmp_read(0xF8);
    xlsb = bmp_read(0xF9);

    adc_P = ((int32_t)msb << 12) |
            ((int32_t)lsb << 4) |
            (xlsb >> 4);

    var1 = (int64_t)t_fine - 128000;

    var2 = var1 * var1 * dig_P6;
    var2 = var2 + ((var1 * dig_P5) << 17);
    var2 = var2 + (((int64_t)dig_P4) << 35);

    var1 = ((var1 * var1 * dig_P3) >> 8) +
           ((var1 * dig_P2) << 12);

    var1 = (((((int64_t)1) << 47) + var1) *
            dig_P1) >> 33;

    if (var1 == 0)
        return 0;

    p = 1048576 - adc_P;

    p = (((p << 31) - var2) * 3125) / var1;

    var1 = ((int64_t)dig_P9 * (p >> 13) *
            (p >> 13)) >> 25;

    var2 = ((int64_t)dig_P8 * p) >> 19;

    p = ((p + var1 + var2) >> 8) +
        (((int64_t)dig_P7) << 4);

    /* Return pressure in Pa */
    return (uint32_t)(p >> 8);
}

/* ---------------- OLED FUNCTIONS ---------------- */

void oled_command(uint8_t cmd)
{
    i2c_start((OLED_ADDR << 1) | 0);

    i2c_write(0x00);
    i2c_write(cmd);

    i2c_stop();
}

void oled_data(uint8_t data)
{
    i2c_start((OLED_ADDR << 1) | 0);

    i2c_write(0x40);
    i2c_write(data);

    i2c_stop();
}

void oled_init(void)
{
    _delay_ms(100);

    oled_command(0xAE); // Display OFF
    oled_command(0xD5);
    oled_command(0x80);

    oled_command(0xA8);
    oled_command(0x3F); // 64 rows

    oled_command(0xD3);
