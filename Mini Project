Bare-metal Embedded C implementation of the Smart Environmental Monitoring and Automatic Fan Control System using the STM32 Nucleo-F401RE


#include "stm32f401re.h"
#include <stdint.h>
#include <stdio.h>


#define BMP_ADDR       0x76
#define OLED_ADDR      0x3C

#define FAN_IN1        (1U << 4)   // PB4
#define FAN_IN2        (1U << 5)   // PB5

volatile uint32_t ms_ticks = 0;
volatile uint8_t manual_mode = 0;

uint16_t dig_T1, dig_P1;
int16_t dig_T2, dig_T3;
int16_t dig_P2, dig_P3, dig_P4;
int16_t dig_P5, dig_P6, dig_P7, dig_P8, dig_P9;

double temperature = 0;
double pressure = 0;


void systick_init(void)
{
    SysTick_Config(16000);       // 1 ms at 16 MHz
}

void delay_ms(uint32_t delay)
{
    uint32_t start = ms_ticks;

    while ((ms_ticks - start) < delay);
}

void SysTick_Handler(void)
{
    ms_ticks++;
}


void uart_init(void)
{
    RCC->AHB1ENR |= (1U << 0);    // GPIOA clock
    RCC->APB1ENR |= (1U << 17);   // USART2 clock

    GPIOA->MODER &= ~((3U << 4) | (3U << 6));
    GPIOA->MODER |=  ((2U << 4) | (2U << 6));

    GPIOA->AFR[0] &= ~((15U << 8) | (15U << 12));
    GPIOA->AFR[0] |=  ((7U << 8) | (7U << 12));

    USART2->BRR = 1667;           // 9600 baud at 16 MHz
    USART2->CR1 = (1U << 3) | (1U << 2) | (1U << 13);
}

void uart_send_char(char c)
{
    while (!(USART2->SR & (1U << 7)));
    USART2->DR = c;
}

void uart_send_string(char *str)
{
    while (*str)
        uart_send_char(*str++);
}


void gpio_init(void)
{
    RCC->AHB1ENR |= (1U << 0) | (1U << 1) | (1U << 2);

    /* PB4 and PB5 as output */
    GPIOB->MODER &= ~((3U << 8) | (3U << 10));
    GPIOB->MODER |=  ((1U << 8) | (1U << 10));

    /* PC13 input for onboard user button */
    GPIOC->MODER &= ~(3U << 26);

    /* Configure EXTI13 */
    RCC->APB2ENR |= (1U << 14);

    SYSCFG->EXTICR[3] &= ~(15U << 4);
    SYSCFG->EXTICR[3] |=  (2U << 4);

    EXTI->IMR  |= (1U << 13);
    EXTI->FTSR |= (1U << 13);
    EXTI->RTSR &= ~(1U << 13);

    NVIC_EnableIRQ(EXTI15_10_IRQn);
}

void EXTI15_10_IRQHandler(void)
{
    if (EXTI->PR & (1U << 13))
    {
        EXTI->PR = (1U << 13);

        static uint32_t last_press = 0;

        if ((ms_ticks - last_press) > 250)
        {
            manual_mode ^= 1U;
            last_press = ms_ticks;
        }
    }
}


void adc_init(void)
{
    RCC->APB2ENR |= (1U << 8);

    GPIOA->MODER |= (3U << 0);    // PA0 analog mode

    ADC1->SQR3 = 0;               // Channel 0
    ADC1->SMPR2 |= (7U << 0);     // Long sampling time
    ADC1->CR2 |= (1U << 0);       // Enable ADC
}

uint16_t adc_read(void)
{
    ADC1->CR2 |= (1U << 30);      // Start conversion

    while (!(ADC1->SR & (1U << 1)));

    return (uint16_t)ADC1->DR;
}


void pwm_init(void)
{
    RCC->APB1ENR |= (1U << 1);

    /* PA6 = TIM3_CH1, alternate function 2 */
    GPIOA->MODER &= ~(3U << 12);
    GPIOA->MODER |=  (2U << 12);

    GPIOA->AFR[0] &= ~(15U << 24);
    GPIOA->AFR[0] |=  (2U << 24);

    TIM3->PSC = 15;
    TIM3->ARR = 999;

    TIM3->CCMR1 &= ~(7U << 4);
    TIM3->CCMR1 |=  (6U << 4);
    TIM3->CCMR1 |=  (1U << 3);

    TIM3->CCER |= (1U << 0);
    TIM3->CCR1 = 0;

    TIM3->CR1 |= (1U << 0);
}

void set_fan_speed(uint8_t percent)
{
    if (percent > 100)
        percent = 100;

    TIM3->CCR1 = (percent * 1000U) / 100U;
}


void i2c_init(void)
{
    RCC->AHB1ENR |= (1U << 1);
    RCC->APB1ENR |= (1U << 21);

    /* PB8 = SCL, PB9 = SDA */
    GPIOB->MODER &= ~((3U << 16) | (3U << 18));
    GPIOB->MODER |=  ((2U << 16) | (2U << 18));

    GPIOB->OTYPER |= (1U << 8) | (1U << 9);

    GPIOB->OSPEEDR |= (3U << 16) | (3U << 18);

    GPIOB->AFR[1] &= ~((15U << 0) | (15U << 4));
    GPIOB->AFR[1] |=  ((4U << 0) | (4U << 4));

    I2C1->CR1 = (1U << 15);
    I2C1->CR1 = 0;

    I2C1->CR2 = 16;
    I2C1->CCR = 80;
    I2C1->TRISE = 17;

    I2C1->CR1 |= (1U << 0);
}

void i2c_start(void)
{
    I2C1->CR1 |= (1U << 8);
    while (!(I2C1->SR1 & (1U << 0)));
}

void i2c_stop(void)
{
    I2C1->CR1 |= (1U << 9);
}

void i2c_address(uint8_t address, uint8_t read)
{
    I2C1->DR = (address << 1) | read;

    while (!(I2C1->SR1 & (1U << 1)));

    volatile uint32_t temp = I2C1->SR1;
    temp = I2C1->SR2;
    (void)temp;
}

void i2c_write(uint8_t data)
{
    while (!(I2C1->SR1 & (1U << 7)));

    I2C1->DR = data;

    while (!(I2C1->SR1 & (1U << 2)));
}

uint8_t i2c_read_ack(void)
{
    I2C1->CR1 |= (1U << 10);

    while (!(I2C1->SR1 & (1U << 6)));

    return I2C1->DR;
}

uint8_t i2c_read_nack(void)
{
    I2C1->CR1 &= ~(1U << 10);

    while (!(I2C1->SR1 & (1U << 6)));

    return I2C1->DR;
}

void i2c_write_register(uint8_t address, uint8_t reg, uint8_t value)
{
    i2c_start();
    i2c_address(address, 0);
    i2c_write(reg);
    i2c_write(value);
    i2c_stop();
}

void i2c_read_registers(uint8_t address, uint8_t reg,
                        uint8_t *data, uint8_t length)
{
    i2c_start();
    i2c_address(address, 0);
    i2c_write(reg);

    i2c_start();
    i2c_address(address, 1);

    for (uint8_t i = 0; i < length; i++)
    {
        if (i == length - 1)
        {
            data[i] = i2c_read_nack();
            i2c_stop();
        }
        else
        {
            data[i] = i2c_read_ack();
        }
    }
}


void bmp280_init(void)
{
    uint8_t id;
    i2c_read_registers(BMP_ADDR, 0xD0, &id, 1);

    if (id != 0x58)
    {
        uart_send_string("BMP280 not detected!\r\n");
        while (1);
    }

    uint8_t calib[24];

    i2c_read_registers(BMP_ADDR, 0x88, calib, 24);

    dig_T1 = (uint16_t)(calib[1] << 8 | calib[0]);
    dig_T2 = (int16_t)(calib[3] << 8 | calib[2]);
    dig_T3 = (int16_t)(calib[5] << 8 | calib[4]);

    dig_P1 = (uint16_t)(calib[7] << 8 | calib[6]);
    dig_P2 = (int16_t)(calib[9] << 8 | calib[8]);
    dig_P3 = (int16_t)(calib[11] << 8 | calib[10]);
    dig_P4 = (int16_t)(calib[13] << 8 | calib[12]);
    dig_P5 = (int16_t)(calib[15] << 8 | calib[14]);
    dig_P6 = (int16_t)(calib[17] << 8 | calib[16]);
    dig_P7 = (int16_t)(calib[19] << 8 | calib[18]);
    dig_P8 = (int16_t)(calib[21] << 8 | calib[20]);
    dig_P9 = (int16_t)(calib[23] << 8 | calib[22]);

    i2c_write_register(BMP_ADDR, 0xF5, 0xA0);
    i2c_write_register(BMP_ADDR, 0xF4, 0x27);
}

void bmp280_read(void)
{
    uint8_t data[6];

    i2c_read_registers(BMP_ADDR, 0xF7, data, 6);

    int32_t adc_P = ((int32_t)data[0] << 12) |
                    ((int32_t)data[1] << 4) |
                    (data[2] >> 4);

    int32_t adc_T = ((int32_t)data[3] << 12) |
                    ((int32_t)data[4] << 4) |
                    (data[5] >> 4);

    double var1, var2, t_fine;

    var1 = (((double)adc_T / 16384.0) -
            ((double)dig_T1 / 1024.0)) * dig_T2;

    var2 = (((double)adc_T / 131072.0 -
            (double)dig_T1 / 8192.0) *
            ((double)adc_T / 131072.0 -
            (double)dig_T1 / 8192.0)) * dig_T3;

    t_fine = var1 + var2;
    temperature = t_fine / 5120.0;

    var1 = (t_fine / 2.0) - 64000.0;
    var2 = var1 * var1 * dig_P6 / 32768.0;
    var2 = var2 + var1 * dig_P5 * 2.0;
    var2 = (var2 / 4.0) + (dig_P4 * 65536.0);

    var1 = (dig_P3 * var1 * var1 / 524288.0 +
            dig_P2 * var1) / 524288.0;

    var1 = (1.0 + var1 / 32768.0) * dig_P1;

    if (var1 == 0)
    {
        pressure = 0;
        return;
    }

    pressure = 1048576.0 - adc_P;
    pressure = (pressure - (var2 / 4096.0)) * 6250.0 / var1;

    var1 = dig_P9 * pressure * pressure / 2147483648.0;
    var2 = pressure * dig_P8 / 32768.0;

    pressure = pressure +
              (var1 + var2 + dig_P7) / 16.0;

    pressure = pressure / 100.0;  // hPa
}


void oled_command(uint8_t cmd)
{
    i2c_start();
    i2c_address(OLED_ADDR, 0);
    i2c_write(0x00);
    i2c_write(cmd);
    i2c_stop();
}

void oled_data(uint8_t data)
{
    i2c_start();
    i2c_address(OLED_ADDR, 0);
    i2c_write(0x40);
    i2c_write(data);
    i2c_stop();
}

void oled_init(void)
{
    delay_ms(100);

    oled_command(0xAE);
    oled_command(0x20);
    oled_command(0x00);
    oled_command(0xA1);
    oled_command(0xC8);
    oled_command(0xA6);
    oled_command(0xA8);
    oled_command(0x3F);
    oled_command(0xD3);
    oled_command(0x00);
    oled_command(0xD5);
    oled_command(0x80);
    oled_command(0xD9);
    oled_command(0xF1);
    oled_command(0xDA);
    oled_command(0x12);
    oled_command(0xDB);
    oled_command(0x40);
    oled_command(0x8D);
    oled_command(0x14);
    oled_command(0xAF);
}

void oled_position(uint8_t page)
{
    oled_command(0xB0 | page);
    oled_command(0x00);
    oled_command(0x10);
}

/* Minimal font: digits and characters used by the display */
const uint8_t digits[10][5] =
{
    {0x3E,0x51,0x49,0x45,0x3E},
    {0x00,0x42,0x7F,0x40,0x00},
    {0x42,0x61,0x51,0x49,0x46},
    {0x21,0x41,0x45,0x4B,0x31},
    {0x18,0x14,0x12,0x7F,0x10},
    {0x27,0x45,0x45,0x45,0x39},
    {0x3C,0x4A,0x49,0x49,0x30},
    {0x01,0x71,0x09,0x05,0x03},
    {0x36,0x49,0x49,0x49,0x36},
    {0x06,0x49,0x49,0x29,0x1E}
};

void oled_char(char c)
{
    uint8_t g[5] = {0,0,0,0,0};

    if (c >= '0' && c <= '9')
    {
        for (int i = 0; i < 5; i++)
            g[i] = digits[c - '0'][i];
    }
    else
    {
        switch (c)
        {
            case 'T': g[0]=0x01; g[1]=0x01; g[2]=0x7F; g[3]=0x01; g[4]=0x01; break;
            case 'P': g[0]=0x7F; g[1]=0x09; g[2]=0x09; g[3]=0x09; g[4]=0x06; break;
            case 'F': g[0]=0x7F; g[1]=0x09; g[2]=0x09; g[3]=0x09; g[4]=0x01; break;
            case 'C': g[0]=0x3E; g[1]=0x41; g[2]=0x41; g[3]=0x41; g[4]=0x22; break;
            case 'H': g[0]=0x7F; g[1]=0x08; g[2]=0x08; g[3]=0x08; g[4]=0x7F; break;
            case 'A': g[0]=0x7E; g[1]=0x11; g[2]=0x11; g[3]=0x11; g[4]=0x7E; break;
            case 'U': g[0]=0x3F; g[1]=0x40; g[2]=0x40; g[3]=0x40; g[4]=0x3F; break;
            case 'O': g[0]=0x3E; g[1]=0x41; g[2]=0x41; g[3]=0x41; g[4]=0x3E; break;
            case ':': g[0]=0x00; g[1]=0x36; g[2]=0x36; break;
            case '.': g[0]=0x00; g[1]=0x60; g[2]=0x60; break;
            case '%': g[0]=0x63; g[1]=0x13; g[2]=0x08; g[3]=0x64; g[4]=0x63; break;
            case ' ': break;
            default: break;
        }
    }

    for (int i = 0; i < 5; i++)
        oled_data(g[i]);

    oled_data(0x00);
}

void oled_string(char *str)
{
    while (*str)
        oled_char(*str++);
}

void oled_clear(void)
{
    for (uint8_t page = 0; page < 8; page++)
    {
        oled_position(page);

        for (uint8_t i = 0; i < 128; i++)
            oled_data(0x00);
    }
}

void oled_display(int temp10, int pressure_hpa, int fan)
{
    char line[20];

    oled_clear();

    oled_position(0);
    sprintf(line, "T:%d.%dC", temp10 / 10,
            (temp10 < 0 ? -temp10 : temp10) % 10);
    oled_string(line);

    oled_position(2);
    sprintf(line, "P:%dHPA", pressure_hpa);
    oled_string(line);

    oled_position(4);
    sprintf(line, "F:%d%%", fan);
    oled_string(line);
}


int main(void)
{
    char message[100];

    systick_init();
    gpio_init();
    uart_init();
    adc_init();
    pwm_init();
    i2c_init();

    uart_send_string("\r\nEnvironmental Monitoring System\r\n");

    bmp280_init();
    oled_init();

    uart_send_string("System started successfully\r\n");

    while (1)
    {
        uint16_t adc_value = adc_read();

        /*
         * Potentiometer:
         * Automatic mode: sets threshold between 20 and 40 C.
         * Manual mode: directly sets fan speed between 0 and 100%.
         */
        int threshold10 = 200 + ((uint32_t)adc_value * 200) / 4095;
        uint8_t manual_speed = ((uint32_t)adc_value * 100) / 4095;

        bmp280_read();

        int temp10 = (int)(temperature * 10.0);
        int pressure_hpa = (int)pressure;

        uint8_t fan_speed;

        if (manual_mode)
        {
            fan_speed = manual_speed;
        }
        else
        {
            int difference = temp10 - threshold10;

            if (difference <= 0)
                fan_speed = 0;
            else
            {
                int calculated_speed = difference * 2;

                if (calculated_speed > 100)
                    calculated_speed = 100;

                fan_speed = (uint8_t)calculated_speed;
            }
        }

        /* Set motor direction and PWM */
        GPIOB->BSRR = FAN_IN1;
        GPIOB->BSRR = ((uint32_t)FAN_IN2 << 16);

        set_fan_speed(fan_speed);

        /* UART output */
        sprintf(message,
                "Temperature: %d.%d C | Pressure: %d hPa | Fan: %d%% | Mode: %s\r\n",
                temp10 / 10,
                (temp10 < 0 ? -temp10 : temp10) % 10,
                pressure_hpa,
                fan_speed,
                manual_mode ? "MANUAL" : "AUTO");

        uart_send_string(message);

        /* OLED output */
        oled_display(temp10, pressure_hpa, fan_speed);

        delay_ms(2000);
    }
}
