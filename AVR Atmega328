6) traffic light sequence that includes a highpriority interrupt designed to trigger a state change only after the current light cycle completes its minimum safe duration
#include <avr/io.h>
#include <avr/interrupt.h>

#define GREEN  PB0
#define ORANGE PB1
#define RED    PB2

volatile unsigned char emergency_flag = 0;

// External Interrupt 0 ISR
ISR(INT0_vect)
{
    emergency_flag = 1;
}

// Custom delay function
void my_delay_ms(unsigned int ms)
{
    unsigned int i, j;

    for (i = 0; i < ms; i++)
    {
        for (j = 0; j < 1000; j++)
        {
            asm volatile ("nop");
        }
    }
}
// Function to control traffic lights
void traffic_light(unsigned char led, unsigned int time)
{
    PORTB = (1 << led);

    // Wait for the current light duration
    my_delay_ms(time);

    // Check emergency flag after duration
    if (emergency_flag == 1)
    {
        // Give priority to Green light
        PORTB = (1 << GREEN);

        my_delay_ms(10000);

        // Clear emergency flag
        emergency_flag = 0;
    }
}

int main(void)
{
    // Configure PB0, PB1 and PB2 as outputs
    DDRB |= (1 << GREEN) | (1 << ORANGE) | (1 << RED);

    // Configure PD2 (INT0) as input
    DDRD &= ~(1 << PD2);

    // Enable internal pull-up resistor
    PORTD |= (1 << PD2);

    // Configure INT0 for falling edge
    EICRA |= (1 << ISC01);
    EICRA &= ~(1 << ISC00);

    // Enable external interrupt INT0
    EIMSK |= (1 << INT0);

    // Enable global interrupts
    sei();

    while (1)
    {
        // Normal traffic light sequence
        traffic_light(GREEN, 10000);
        traffic_light(ORANGE, 3000);
        traffic_light(RED, 10000);
    }

    return 0;
}

7) Two independent timing tasks simultaneously using the 16-bit Timer1 and the 8-bit Timer2
#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <stdint.h>

// Counter for Timer2
volatile uint16_t timer2_count = 0;

// Timer1 ISR - Every 2 seconds
ISR(TIMER1_COMPA_vect)
{
    PORTB ^= (1 << PB1);  // Toggle Status LED
}

// Timer2 ISR - Every 2 milliseconds
ISR(TIMER2_COMPA_vect)
{
    timer2_count++;

    // 250 x 2 ms = 500 ms
    if (timer2_count >= 250)
    {
        PORTB ^= (1 << PB2);  // Toggle Heartbeat LED
        timer2_count = 0;
    }
}

int main(void)
{
    // Configure PB1 and PB2 as outputs
    DDRB |= (1 << PB1) | (1 << PB2);

    // Initially turn OFF both LEDs
    PORTB &= ~((1 << PB1) | (1 << PB2));

    // -------------------------
    // TIMER1 CONFIGURATION
    // -------------------------

    // CTC mode
    TCCR1A = 0;
    TCCR1B = (1 << WGM12);

    // Prescaler = 1024
    TCCR1B |= (1 << CS12) | (1 << CS10);

    // 2 seconds:
    // (16000000 / 1024) x 2 = 31250
    OCR1A = 31249;

    // Reset Timer1 counter
    TCNT1 = 0;

    // Enable Timer1 Compare Match A
    TIMSK1 |= (1 << OCIE1A);

    // -------------------------
    // TIMER2 CONFIGURATION
    // -------------------------

    // CTC mode
    TCCR2A = (1 << WGM21);

    // Prescaler = 128
    TCCR2B = (1 << CS22) | (1 << CS20);

    // 2 milliseconds:
    // (16000000 / 128) x 0.002 = 250
    OCR2A = 249;

    // Reset Timer2 counter
    TCNT2 = 0;

    // Enable Timer2 Compare Match A
    TIMSK2 |= (1 << OCIE2A);

    // Enable global interrupts
    sei();

    while (1)
    {
        // Timers run independently
    }

    return 0;
}

