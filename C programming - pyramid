#include <stdio.h>
int secondLargest(int arr[], int n)
{
int largest = arr[0];
int second = arr[1];
if (second > largest)
{
    int temp = largest;
    largest = second;
    second = temp;
}

for (int i = 2; i < n; i++)
{
    if (arr[i] > largest)
    {
        second = largest;
        largest = arr[i];
    }
    else if (arr[i] > second)
    {
        second = arr[i];
    }
}

return second;
}
unsigned char modifyRegister(unsigned char reg)
{
reg |= (1 << 2);
reg &= ~(1 << 5);
reg ^= (1 << 0);
return reg;
}
void pyramid(int n)
{
for (int i = 1; i <= n; i++)
{
for (int j = 1; j <= n - i; j++)
printf(" ");
   for (int j = 1; j <= 2 * i - 1; j++)
        printf("*");

    printf("\n");
}
}
int main()
{
int arr[] = {10, 25, 7, 30, 18};
int n = 5;
printf("Second largest = %d\n", secondLargest(arr, n));


unsigned char reg = 0x21;

reg = modifyRegister(reg);

printf("Modified register = %u\n", reg);


printf("\nPyramid:\n");
pyramid(5);

return 0;
}

