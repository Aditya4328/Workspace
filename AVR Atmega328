void oled_string(char *str)
{
    while (*str)
        oled_char(*str++);
}

// Delay function
void delay_2_seconds(void)
{
    for (uint8_t i = 0; i < 20; i++)
        _delay_ms(100);
}

//Main function
int main(void)
{
    int32_t temperature;
    uint32_t pressure;

    char temp_str[20];
    char pressure_str[20];

    uint32_t temp_abs;
    uint32_t pressure_hpa;

    i2c_init();

    bmp_init();
    oled_init();

    oled_clear();

    while (1)
    {
        /* Read temperature */
        temperature = read_temperature();

        /* Read pressure */
        pressure = read_pressure();

        /* Convert temperature to readable text */
        if (temperature < 0)
        {
            temp_abs = (uint32_t)(-temperature);

            snprintf(temp_str, sizeof(temp_str),
                     "TEMP: -%lu.%02lu C",
                     (unsigned long)(temp_abs / 100),
                     (unsigned long)(temp_abs % 100));
        }
        else
        {
            temp_abs = (uint32_t)temperature;

            snprintf(temp_str, sizeof(temp_str),
                     "TEMP: %lu.%02lu C",
                     (unsigned long)(temp_abs / 100),
                     (unsigned long)(temp_abs % 100));
        }

        /* Convert pressure Pa to hPa */
        pressure_hpa = pressure / 100;

        snprintf(pressure_str, sizeof(pressure_str),
                 "PRESS: %lu hPa",
                 (unsigned long)pressure_hpa);

        /* Update OLED */
        oled_clear();

        oled_cursor(2, 0);
        oled_string(temp_str);

        oled_cursor(4, 0);
        oled_string(pressure_str);

        /* Wait 2 seconds */
        delay_2_seconds();
    }
}



