2) Toggle between a Red LED and a Green LED
#include <avr/io.h>
#include <util/delay.h>

int main(void)
{
    // PD2 and PD3 as output
    DDRD |= (1 << PD2) | (1 << PD3);

    // PD4 as input
    DDRD &= ~(1 << PD4);

    // Enable internal pull-up resistor
    PORTD |= (1 << PD4);

    // Initially Red LED ON
    PORTD |= (1 << PD2);
    PORTD &= ~(1 << PD3);

    while (1)
    {
        // Check if button is pressed
        if (!(PIND & (1 << PD4)))
        {
            _delay_ms(50);

            if (!(PIND & (1 << PD4)))
            {
                // Check current LED state
                if (PORTD & (1 << PD2))
                {
                    // Red OFF, Green ON
                    PORTD &= ~(1 << PD2);
                    PORTD |= (1 << PD3);
                }
                else
                {
                    // Green OFF, Red ON
                    PORTD &= ~(1 << PD3);
                    PORTD |= (1 << PD2);
                }
                // Wait until button is released
                while (!(PIND & (1 << PD4)));

                _delay_ms(50);
            }
        }
    }
    return 0;
}

